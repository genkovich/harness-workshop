{
  "name": "harness-workshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.11.0"
  },
  "scripts": {
    "smoke": "tsx --env-file-if-exists=.env smoke.ts",
    "agent": "tsx --env-file-if-exists=.env cli.ts",
    "demo": "tsx scripts/demo.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.76",
    "@ai-sdk/groq": "4.0.46",
    "ai": "7.0.107",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
